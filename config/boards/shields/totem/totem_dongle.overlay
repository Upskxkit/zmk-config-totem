/*
 * Totem dongle shield – fake 1x1 matrix just so ZMK's matrix code is happy.
 */

 / {
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio";
        label = "KSCAN_DONGLE";

        rows = <1>;
        columns = <1>;

        // Use any valid GPIO controller on the nRF52840.
        // gpio0 is standard on Nordic SoCs.
        row-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
        col-gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
    };

    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };
    
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <1>;
        rows = <1>;
        map = <RC(0,0)>;
    };
};
