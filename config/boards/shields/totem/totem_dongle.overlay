/*
 * Totem dongle shield – no key matrix, just a receiver.
 */

 / {
    kscan0: kscan0 {
        compatible = "zmk,kscan-none";
        label = "KSCAN_DONGLE";
    };

    chosen {
        zmk,kscan = &kscan0;
    };
};